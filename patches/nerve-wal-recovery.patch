diff --git a/test/wal_recovery_test.ts b/test/wal_recovery_test.ts
new file mode 100644
index 0000000..98013c0
--- /dev/null
+++ b/test/wal_recovery_test.ts
@@ -0,0 +1,63 @@
+import { test, expect } from "bun:test";
+import { mkdtempSync, mkdirSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+test("recovers relation frames after unaligned variable-length text frames", () => {
+    const root=mkdtempSync(join(tmpdir(),"nerve-wal-recovery-"));
+    mkdirSync(join(root,"db"));
+    const entry=pathToFileURL(resolve(import.meta.dir,"../packages/nerve-bun")).href;
+    const prefix=`const {Engine,DbMode}=await import(${JSON.stringify(entry)});`;
+    const run=(body:string)=>Bun.spawnSync([process.execPath,"-e",prefix+body],{cwd:root,stdout:"pipe",stderr:"pipe"});
+    try {
+        const write=run(`Engine.setMode(DbMode.StrictAcid);Engine.upsertArticle(42,"abc",["minecraft:iron_ingot"]);Engine.upsertArticle(43,"variable UTF-8 ä",["create:mechanical_press"]);process.exit(0);`);
+        expect(write.exitCode).toBe(0);
+        const read=run(`console.log(JSON.stringify({text:Engine.getArticleText(42),matches:Engine.getTopMatchesUnique(["minecraft:iron_ingot"],[],3)}));`);
+        expect(read.exitCode).toBe(0);
+        const result=JSON.parse(read.stdout.toString());
+        expect(result.text).toBe("abc");expect(result.matches[0].id).toBe(42);
+    } finally {rmSync(root,{recursive:true,force:true});}
+});
+
+test("large WAL replay survives buffer materialization/GC without cached FFI addresses", () => {
+    const root=mkdtempSync(join(tmpdir(),"nerve-large-recovery-"));
+    mkdirSync(join(root,"db"));
+    const entry=pathToFileURL(resolve(import.meta.dir,"../packages/nerve-bun")).href;
+    const prefix=`const {Engine,DbMode}=await import(${JSON.stringify(entry)});`;
+    const run=(body:string)=>Bun.spawnSync([process.execPath,"-e",prefix+body],{cwd:root,stdout:"pipe",stderr:"pipe",timeout:20000});
+    try {
+        const write=run(`Engine.setMode(DbMode.FastWal);for(let i=0;i<50000;i++)Engine.upsertArticle(i,"row"+i+"x".repeat(1024),["article:"+i,"recovery"]);process.exit(0);`);
+        expect(write.exitCode).toBe(0);
+        const read=run(`console.log(JSON.stringify([0,25000,49999].map(id=>Engine.getArticleText(id))));`);
+        expect(read.exitCode).toBe(0);
+        const texts=JSON.parse(read.stdout.toString());
+        expect(texts).toEqual([0,25000,49999].map(id=>"row"+id+"x".repeat(1024)));
+        const again=run(`console.log(Engine.getTopMatchesUnique(["article:49999"],[],1)[0]?.id);`);
+        expect(again.exitCode).toBe(0);expect(again.stdout.toString().trim()).toBe("49999");
+    } finally {rmSync(root,{recursive:true,force:true});}
+});
+
+test("recovery may merge RAM batches without truncating the unread WAL tail", async () => {
+    const {readFileSync,writeFileSync}=await import("node:fs");
+    const root=mkdtempSync(join(tmpdir(),"nerve-batched-recovery-"));
+    const entry=pathToFileURL(resolve(import.meta.dir,"../packages/nerve-bun")).href;
+    const prefix=`const {Engine,DbMode}=await import(${JSON.stringify(entry)});`;
+    const run=(folder:string,body:string)=>Bun.spawnSync([process.execPath,"-e",prefix+body],{cwd:join(root,folder),stdout:"pipe",stderr:"pipe",timeout:20000});
+    try {
+        for(const folder of ["left","right","recovered"]) mkdirSync(join(root,folder,"db"),{recursive:true});
+        for(const [folder,start] of [["left",0],["right",60000]] as const) {
+            const result=run(folder,`Engine.setMode(DbMode.FastWal);for(let i=${start};i<${start+60000};i++)Engine.upsertArticle(i,"row"+i,["article:"+i,...Array.from({length:11},(_,k)=>"common:"+k)]);process.exit(0);`);
+            expect(result.exitCode).toBe(0);
+        }
+        // Both streams consist entirely of native, committed WAL frames. Their combination
+        // exceeds the 2,000,000-u32 replay buffer without rewriting any frame/header/CRC.
+        writeFileSync(join(root,"recovered/db/changes.log.bin"),Buffer.concat([
+            readFileSync(join(root,"left/db/changes.log.bin")),readFileSync(join(root,"right/db/changes.log.bin"))]));
+        for(let pass=0;pass<2;pass++) {
+            const result=run("recovered",`console.log(JSON.stringify([0,59999,60000,119999].map(id=>Engine.getArticleText(id))));`);
+            expect(result.exitCode).toBe(0);
+            expect(JSON.parse(result.stdout.toString())).toEqual(["row0","row59999","row60000","row119999"]);
+        }
+    } finally {rmSync(root,{recursive:true,force:true});}
+});
